{-# OPTIONS --safe --without-K #-}

-- MasterMonoid.agda: the truncated master monoid M₂ = Mon(C₂) of
-- arXiv 2611.32655 (Carcacía-Campos, "One Monoid to Realize Them All"),
-- written by hand from the paper apart from the Java code, and the
-- Tonnetz as a 2-dimensional semisimplicial set.
--
-- C₂ = (Δ^{≤2}_inj)^op (Def. 4.3) has objects [0], [1], [2] and eleven
-- arrows: three identities, the faces d¹ᵢ : [1] → [0] and d²ⱼ : [2] → [1],
-- and the three arrows [2] → [0], named here by the vertex of [2] they
-- keep (keep0, keep1, keep2). The face d^k_i keeps every vertex but i,
-- so d¹ᵢ ∘ d²ⱼ keeps the (1 − i)-th of the two vertices that d²ⱼ keeps.
--
-- Mon(C₂) is generated by the arrows with [g][f] = [g ∘ f] (Def. 2.1).
-- A word u₁ … uₖ is a list with u₁ first; uₖ acts first. `normalize`
-- reduces a word by one left-to-right pass (Lemma 2.3), and the facts
-- below are proved by computation.

module MasterMonoid where

open import Prelude

------------------------------------------------------------------------
-- The category C₂

data Ob : Set where
  o0 o1 o2 : Ob

data Arr : Set where
  idA : Ob → Arr
  d10 d11 : Arr
  d20 d21 d22 : Arr
  keep0 keep1 keep2 : Arr

dom : Arr → Ob
dom (idA x) = x
dom d10 = o1
dom d11 = o1
dom d20 = o2
dom d21 = o2
dom d22 = o2
dom keep0 = o2
dom keep1 = o2
dom keep2 = o2

cod : Arr → Ob
cod (idA x) = x
cod d10 = o0
cod d11 = o0
cod d20 = o1
cod d21 = o1
cod d22 = o1
cod keep0 = o0
cod keep1 = o0
cod keep2 = o0

_==ᴼ_ : Ob → Ob → Bool
o0 ==ᴼ o0 = true
o1 ==ᴼ o1 = true
o2 ==ᴼ o2 = true
_  ==ᴼ _  = false

isId : Arr → Bool
isId (idA _) = true
isId _       = false

-- g ∘ f when cod f = dom g. Only d¹ᵢ ∘ d²ⱼ joins two non-identity arrows:
-- d²₀ keeps {1, 2}, d²₁ keeps {0, 2}, d²₂ keeps {0, 1}, and d¹₀ keeps the
-- second of them, d¹₁ the first.
comp : Arr → Arr → Maybe Arr
comp (idA x) f   = if cod f ==ᴼ x then just f else nothing
comp g (idA x)   = if dom g ==ᴼ x then just g else nothing
comp d10 d20 = just keep2
comp d11 d20 = just keep1
comp d10 d21 = just keep2
comp d11 d21 = just keep0
comp d10 d22 = just keep1
comp d11 d22 = just keep0
comp _ _ = nothing

------------------------------------------------------------------------
-- Words of M₂ and their reduced forms (Def. 2.1, Lemma 2.3)

letters : List Arr
letters = d10 ∷ d11 ∷ d20 ∷ d21 ∷ d22 ∷ keep0 ∷ keep1 ∷ keep2 ∷ []

-- The stack holds the reduced word built so far, last letter on top.
push : List Arr → Arr → List Arr
push st u with isId u
... | true = st
... | false = go st
  where
  go : List Arr → List Arr
  go [] = u ∷ []
  go (v ∷ vs) with comp v u
  ... | nothing = u ∷ v ∷ vs
  ... | just w  = if isId w then vs else (w ∷ vs)

foldl : {A B : Set} → (B → A → B) → B → List A → B
foldl f b []       = b
foldl f b (x ∷ xs) = foldl f (f b x) xs

reverse : {A : Set} → List A → List A
reverse = foldl (λ acc x → x ∷ acc) []

normalize : List Arr → List Arr
normalize w = reverse (foldl push [] w)

-- Reduced: no identity letter, and dom uᵢ ≠ cod uᵢ₊₁ for neighbours.
isReduced : List Arr → Bool
isReduced []           = true
isReduced (u ∷ [])     = not (isId u)
isReduced (u ∷ v ∷ ws) = not (isId u) && not (dom u ==ᴼ cod v) && isReduced (v ∷ ws)

------------------------------------------------------------------------
-- The relations of M₂ as printed on p. 19 (Prop. 4.4), by refl

rel1 : normalize (d10 ∷ d21 ∷ []) ≡ normalize (d10 ∷ d20 ∷ [])
rel1 = refl

rel2 : normalize (d10 ∷ d22 ∷ []) ≡ normalize (d11 ∷ d20 ∷ [])
rel2 = refl

rel3 : normalize (d11 ∷ d22 ∷ []) ≡ normalize (d11 ∷ d21 ∷ [])
rel3 = refl

-- Some normal forms.

nf-d10d21 : normalize (d10 ∷ d21 ∷ []) ≡ keep2 ∷ []
nf-d10d21 = refl

nf-reduced-pair : normalize (d20 ∷ d10 ∷ []) ≡ d20 ∷ d10 ∷ []
nf-reduced-pair = refl

nf-four : normalize (d10 ∷ d22 ∷ d11 ∷ d20 ∷ []) ≡ keep1 ∷ keep1 ∷ []
nf-four = refl

nf-identity-drops : normalize (idA o2 ∷ d21 ∷ idA o2 ∷ []) ≡ d21 ∷ []
nf-identity-drops = refl

-- The relation d¹₀ d²₁ = d¹₀ d²₀ makes two different branch letters agree
-- after one more face (Example 4.9 uses it on the edge e).
nf-branch : normalize (d10 ∷ d20 ∷ d21 ∷ []) ≡ normalize (d10 ∷ d21 ∷ d21 ∷ [])
nf-branch = refl

------------------------------------------------------------------------
-- Counting reduced words (the Java test counts the same: 8, 58, 416)

concatMap : {A B : Set} → (A → List B) → List A → List B
concatMap f []       = []
concatMap f (x ∷ xs) = app (f x) (concatMap f xs)
  where
  app : {C : Set} → List C → List C → List C
  app []       ys = ys
  app (z ∷ zs) ys = z ∷ app zs ys

wordsOf : Nat → List (List Arr)
wordsOf zero    = [] ∷ []
wordsOf (suc n) = concatMap (λ w → map (λ u → u ∷ w) letters) (wordsOf n)

count : {A : Set} → (A → Bool) → List A → Nat
count p []       = 0
count p (x ∷ xs) = if p x then suc (count p xs) else count p xs

reduced-1 : count isReduced (wordsOf 1) ≡ 8
reduced-1 = refl

reduced-2 : count isReduced (wordsOf 2) ≡ 58
reduced-2 = refl

reduced-3 : count isReduced (wordsOf 3) ≡ 416
reduced-3 = refl

-- normalize returns a reduced word and fixes reduced words, on all
-- 8³ = 512 words of length 3.
normal-is-reduced : all (λ w → isReduced (normalize w)) (wordsOf 3) ≡ true
normal-is-reduced = refl

eqArr : Arr → Arr → Bool
eqArr (idA x) (idA y) = x ==ᴼ y
eqArr d10 d10 = true
eqArr d11 d11 = true
eqArr d20 d20 = true
eqArr d21 d21 = true
eqArr d22 d22 = true
eqArr keep0 keep0 = true
eqArr keep1 keep1 = true
eqArr keep2 keep2 = true
eqArr _ _ = false

eqWord : List Arr → List Arr → Bool
eqWord []       []       = true
eqWord (u ∷ us) (v ∷ vs) = eqArr u v && eqWord us vs
eqWord _        _        = false

reduced-fixed : all (λ w → if isReduced w then eqWord (normalize w) w else true) (wordsOf 3) ≡ true
reduced-fixed = refl

------------------------------------------------------------------------
-- The presentation of M_n (Prop. 4.4): generators d^k_i for 1 ≤ k ≤ n,
-- 0 ≤ i ≤ k, and one relation d^{k−1}_i d^k_j = d^{k−1}_{j−1} d^k_i for
-- each 2 ≤ k ≤ n and 0 ≤ i < j ≤ k.

upTo : Nat → List Nat
upTo zero    = zero ∷ []
upTo (suc n) = app (upTo n) (suc n ∷ [])
  where
  app : List Nat → List Nat → List Nat
  app []       ys = ys
  app (z ∷ zs) ys = z ∷ app zs ys

from1 : Nat → List Nat
from1 n = drop1 (upTo n)
  where
  drop1 : List Nat → List Nat
  drop1 []       = []
  drop1 (_ ∷ xs) = xs

gens : Nat → List (Σ Nat (λ _ → Nat))
gens n = concatMap (λ k → map (λ i → k , i) (upTo k)) (from1 n)

rels : Nat → List (Σ Nat (λ _ → Σ Nat (λ _ → Nat)))
rels n = concatMap (λ k → if k <ᵇ 2 then [] else
           concatMap (λ j → concatMap (λ i → if i <ᵇ j then ((k , (i , j)) ∷ []) else []) (upTo k)) (upTo k))
         (from1 n)

-- n(n+3)/2 generators and the sum of C(k+1, 2) relations, n = 1 .. 7.
gens-count : map (λ n → length (gens n)) (1 ∷ 2 ∷ 3 ∷ 4 ∷ 5 ∷ 6 ∷ 7 ∷ []) ≡ 2 ∷ 5 ∷ 9 ∷ 14 ∷ 20 ∷ 27 ∷ 35 ∷ []
gens-count = refl

rels-count : map (λ n → length (rels n)) (1 ∷ 2 ∷ 3 ∷ 4 ∷ 5 ∷ 6 ∷ 7 ∷ []) ≡ 0 ∷ 3 ∷ 9 ∷ 19 ∷ 34 ∷ 55 ∷ 83 ∷ []
rels-count = refl

-- The three relations of M₂, as (k, i, j), in the printed order.
rels-2 : rels 2 ≡ (2 , (0 , 1)) ∷ (2 , (0 , 2)) ∷ (2 , (1 , 2)) ∷ []
rels-2 = refl

------------------------------------------------------------------------
-- The Tonnetz as a semisimplicial set (this fork's example, not the
-- paper's). Vertices are pitch classes 0 .. 11. An edge is an interval
-- class with its lower pitch class: M3 (x → x + 4), m3 (x → x + 3),
-- P5 (x → x + 7), with d₀ the upper and d₁ the lower end. A triad's
-- vertices are ordered root, third, fifth (a choice), so its faces are
-- d₀ = third-fifth, d₁ = root-fifth, d₂ = root-third.

infixr 2 _×_
_×_ : Set → Set → Set
A × B = Σ A (λ _ → B)

mod12 : Nat → Nat
mod12 n = mod-helper 0 11 n 11

data Kind : Set where
  M3 m3 P5 : Kind

data Edge : Set where
  edge : Kind → Nat → Edge

step : Kind → Nat
step M3 = 4
step m3 = 3
step P5 = 7

e-d0 : Edge → Nat
e-d0 (edge k x) = mod12 (x + step k)

e-d1 : Edge → Nat
e-d1 (edge _ x) = x

data Triad : Set where
  major minor : Nat → Triad

t-d0 t-d1 t-d2 : Triad → Edge
t-d0 (major r) = edge m3 (mod12 (r + 4))
t-d0 (minor r) = edge M3 (mod12 (r + 3))
t-d1 (major r) = edge P5 r
t-d1 (minor r) = edge P5 r
t-d2 (major r) = edge M3 r
t-d2 (minor r) = edge m3 r

roots : List Nat
roots = upTo 11

triads : List Triad
triads = app (map major roots) (map minor roots)
  where
  app : List Triad → List Triad → List Triad
  app []       ys = ys
  app (z ∷ zs) ys = z ∷ app zs ys

edges : List Edge
edges = app (map (edge M3) roots) (app (map (edge m3) roots) (map (edge P5) roots))
  where
  app : List Edge → List Edge → List Edge
  app []       ys = ys
  app (z ∷ zs) ys = z ∷ app zs ys

-- The semisimplicial identities d_i d_j = d_{j−1} d_i (i < j) on a triad
-- with faces f0, f1, f2: d₀d₁ = d₀d₀, d₀d₂ = d₁d₀, d₁d₂ = d₁d₁.
identities : (Triad → Edge) → (Triad → Edge) → (Triad → Edge) → Triad → Bool
identities f0 f1 f2 t =
  (e-d0 (f1 t) ==ⁿ e-d0 (f0 t)) && (e-d0 (f2 t) ==ⁿ e-d1 (f0 t)) && (e-d1 (f2 t) ==ⁿ e-d1 (f1 t))

tonnetz-identities : all (identities t-d0 t-d1 t-d2) triads ≡ true
tonnetz-identities = refl

counts : length roots ≡ 12 × length edges ≡ 36 × length triads ≡ 24
counts = refl , refl , refl

eqKind : Kind → Kind → Bool
eqKind M3 M3 = true
eqKind m3 m3 = true
eqKind P5 P5 = true
eqKind _  _  = false

eqEdge : Edge → Edge → Bool
eqEdge (edge k x) (edge l y) = eqKind k l && (x ==ⁿ y)

hasFace : Edge → Triad → Bool
hasFace e t = eqEdge (t-d0 t) e || eqEdge (t-d1 t) e || eqEdge (t-d2 t) e

-- Every interval edge lies on exactly two triads, so the 24 triangles
-- close up into a surface without boundary.
two-triads : all (λ e → count (hasFace e) triads ==ⁿ 2) edges ≡ true
two-triads = refl

-- C major: d₀ = E-G (minor third from 4), d₁ = C-G, d₂ = C-E.
c-major : (t-d0 (major 0) ≡ edge m3 4) × (t-d1 (major 0) ≡ edge P5 0) × (t-d2 (major 0) ≡ edge M3 0)
c-major = refl , refl , refl
