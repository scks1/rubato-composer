{-# OPTIONS --safe --without-K #-}

-- Global.agda: finite facts about the nerves of the third-chain
-- interpretations of the C-major scale, proved by computation. The
-- covering sets are the degree charts of Mazzola, The Topos of Music,
-- vol. I, section 13.4.2 (p. 262) and Ex. 21 (p. 275): for degree i the
-- triadic chart is {x_i, x_i+2, x_i+4} and the tetradic chart adds x_i+6,
-- with indexes mod 7. The nerve has a simplex for every non-empty set of
-- charts with a common tone (section 13.2.1, p. 253). The charts are
-- written out below as data; java/core's org.rubato.math.global computes
-- the same charts from the scale.
--
-- Facts:
--  * the triadic nerve is exactly the complex generated by the seven
--    triangles {I,III,VI} ... (the tone stars), with f-vector 7, 14, 7
--    and Euler characteristic 0; its boundary (edges in exactly one
--    triangle) is the seven edges of the fifth sequence; every edge lies
--    in one or two triangles (Topos I p. 262, the harmonic strip);
--  * the tetradic nerve is exactly the complex generated by S1..S7 of
--    Agustin-Aquino and Mazzola (J. Math. Music 14, 2020, section 6), its
--    1-skeleton is K7, its f-vector 7, 21, 21, 7 and its Euler
--    characteristic 0; every triangle lies in one or two tetrahedra.
-- Orientability and homology are checked in Java only (NerveTest).

module Global where

open import Prelude

------------------------------------------------------------------------
-- Lists

_++_ : {A : Set} → List A → List A → List A
[]       ++ ys = ys
(x ∷ xs) ++ ys = x ∷ (xs ++ ys)

filter : {A : Set} → (A → Bool) → List A → List A
filter p []       = []
filter p (x ∷ xs) = if p x then x ∷ filter p xs else filter p xs

count : {A : Set} → (A → Bool) → List A → Nat
count p xs = length (filter p xs)

mem : Nat → List Nat → Bool
mem x xs = any (λ y → x ==ⁿ y) xs

_⊆ᵇ_ : List Nat → List Nat → Bool
xs ⊆ᵇ ys = all (λ x → mem x ys) xs

eqL : List Nat → List Nat → Bool
eqL []       []       = true
eqL (x ∷ xs) (y ∷ ys) = (x ==ⁿ y) && eqL xs ys
eqL _        _        = false

memL : List Nat → List (List Nat) → Bool
memL s ss = any (eqL s) ss

-- Boolean equivalence
_⇔ᵇ_ : Bool → Bool → Bool
true  ⇔ᵇ b = b
false ⇔ᵇ b = not b

-- all subsets of a list, each in the list's order
subsets : List Nat → List (List Nat)
subsets []       = [] ∷ []
subsets (x ∷ xs) = subsets xs ++ map (x ∷_) (subsets xs)

nonEmpty : List Nat → Bool
nonEmpty []      = false
nonEmpty (_ ∷ _) = true

------------------------------------------------------------------------
-- Degrees I..VII as 0..6, tones as pitch classes

degrees : List Nat
degrees = 0 ∷ 1 ∷ 2 ∷ 3 ∷ 4 ∷ 5 ∷ 6 ∷ []

-- C major {0, 2, 4, 5, 7, 9, 11}
scale : List Nat
scale = 0 ∷ 2 ∷ 4 ∷ 5 ∷ 7 ∷ 9 ∷ 11 ∷ []

triad : Nat → List Nat
triad 0 = 0 ∷ 4 ∷ 7 ∷ []      -- I    C E G
triad 1 = 2 ∷ 5 ∷ 9 ∷ []      -- II   D F A
triad 2 = 4 ∷ 7 ∷ 11 ∷ []     -- III  E G B
triad 3 = 5 ∷ 9 ∷ 0 ∷ []      -- IV   F A C
triad 4 = 7 ∷ 11 ∷ 2 ∷ []     -- V    G B D
triad 5 = 9 ∷ 0 ∷ 4 ∷ []      -- VI   A C E
triad 6 = 11 ∷ 2 ∷ 5 ∷ []     -- VII  B D F
triad _ = []

tetrad : Nat → List Nat
tetrad 0 = 0 ∷ 4 ∷ 7 ∷ 11 ∷ []    -- I    C E G B
tetrad 1 = 2 ∷ 5 ∷ 9 ∷ 0 ∷ []     -- II   D F A C
tetrad 2 = 4 ∷ 7 ∷ 11 ∷ 2 ∷ []    -- III  E G B D
tetrad 3 = 5 ∷ 9 ∷ 0 ∷ 4 ∷ []     -- IV   F A C E
tetrad 4 = 7 ∷ 11 ∷ 2 ∷ 5 ∷ []    -- V    G B D F
tetrad 5 = 9 ∷ 0 ∷ 4 ∷ 7 ∷ []     -- VI   A C E G
tetrad 6 = 11 ∷ 2 ∷ 5 ∷ 9 ∷ []    -- VII  B D F A
tetrad _ = []

------------------------------------------------------------------------
-- The nerve of a covering by charts indexed by degrees

-- the charts in σ have a common tone
meets : (Nat → List Nat) → List Nat → Bool
meets chart σ = any (λ x → all (λ c → mem x (chart c)) σ) scale

nerve : (Nat → List Nat) → List (List Nat)
nerve chart = filter (λ σ → nonEmpty σ && meets chart σ) (subsets degrees)

-- the complex generated by a list of simplexes: the non-empty faces
generated : List (List Nat) → List Nat → Bool
generated gens σ = nonEmpty σ && any (λ g → σ ⊆ᵇ g) gens

-- the nerve is exactly the complex generated by gens, decided over all
-- 128 subsets of the seven degrees
exactly : (Nat → List Nat) → List (List Nat) → Bool
exactly chart gens =
  all (λ σ → (nonEmpty σ && meets chart σ) ⇔ᵇ generated gens σ) (subsets degrees)

faces : Nat → List (List Nat) → Nat
faces q ss = count (λ σ → length σ ==ⁿ suc q) ss

fvector3 : List (List Nat) → List Nat
fvector3 ss = faces 0 ss ∷ faces 1 ss ∷ faces 2 ss ∷ faces 3 ss ∷ []

-- how many simplexes of ss of dimension q + 1 contain the q-simplex σ
cofaces : Nat → List (List Nat) → List Nat → Nat
cofaces q ss σ = count (λ τ → (length τ ==ⁿ suc (suc q)) && (σ ⊆ᵇ τ)) ss

------------------------------------------------------------------------
-- The triadic nerve: the harmonic strip

I II III IV V VI VII : Nat
I = 0
II = 1
III = 2
IV = 3
V = 4
VI = 5
VII = 6

-- the seven triangles: the degrees whose triads hold a given tone
tone-stars : List (List Nat)
tone-stars =
    (I ∷ IV ∷ VI ∷ [])        -- C
  ∷ (II ∷ V ∷ VII ∷ [])       -- D
  ∷ (I ∷ III ∷ VI ∷ [])       -- E
  ∷ (II ∷ IV ∷ VII ∷ [])      -- F
  ∷ (I ∷ III ∷ V ∷ [])        -- G
  ∷ (II ∷ IV ∷ VI ∷ [])       -- A
  ∷ (III ∷ V ∷ VII ∷ [])      -- B
  ∷ []

strip : List (List Nat)
strip = nerve triad

strip-exactly : exactly triad tone-stars ≡ true
strip-exactly = refl

strip-f : fvector3 strip ≡ 7 ∷ 14 ∷ 7 ∷ 0 ∷ []
strip-f = refl

-- Euler characteristic 7 - 14 + 7 = 0, as V + F = E
strip-euler : faces 0 strip + faces 2 strip ≡ faces 1 strip
strip-euler = refl

-- the boundary: the edges in exactly one triangle
boundary : List (List Nat)
boundary = filter (λ σ → (length σ ==ⁿ 2) && (cofaces 1 strip σ ==ⁿ 1)) strip

-- the fifth sequence V - I - IV - VII - III - VI - II - V, as sorted edges
fifth-edges : List (List Nat)
fifth-edges =
    (I ∷ IV ∷ []) ∷ (I ∷ V ∷ []) ∷ (II ∷ V ∷ []) ∷ (II ∷ VI ∷ [])
  ∷ (III ∷ VI ∷ []) ∷ (III ∷ VII ∷ []) ∷ (IV ∷ VII ∷ []) ∷ []

boundary-size : length boundary ≡ 7
boundary-size = refl

boundary-is-fifths : all (λ e → memL e fifth-edges) boundary
                     && all (λ e → memL e boundary) fifth-edges ≡ true
boundary-is-fifths = refl

-- every edge of the strip lies in one or two triangles
strip-edges-pseudo :
  all (λ σ → not (length σ ==ⁿ 2) || ((cofaces 1 strip σ ==ⁿ 1) || (cofaces 1 strip σ ==ⁿ 2))) strip ≡ true
strip-edges-pseudo = refl

------------------------------------------------------------------------
-- The tetradic nerve

-- S1..S7 of Agustin-Aquino and Mazzola 2020, section 6, sorted
S-list : List (List Nat)
S-list =
    (I ∷ II ∷ IV ∷ VI ∷ [])       -- S1
  ∷ (II ∷ III ∷ V ∷ VII ∷ [])     -- S2
  ∷ (I ∷ III ∷ IV ∷ VI ∷ [])      -- S3
  ∷ (II ∷ IV ∷ V ∷ VII ∷ [])      -- S4
  ∷ (I ∷ III ∷ V ∷ VI ∷ [])       -- S5
  ∷ (II ∷ IV ∷ VI ∷ VII ∷ [])     -- S6
  ∷ (I ∷ III ∷ V ∷ VII ∷ [])      -- S7
  ∷ []

torus : List (List Nat)
torus = nerve tetrad

torus-exactly : exactly tetrad S-list ≡ true
torus-exactly = refl

torus-f : fvector3 torus ≡ 7 ∷ 21 ∷ 21 ∷ 7 ∷ []
torus-f = refl

-- Euler characteristic 7 - 21 + 21 - 7 = 0
torus-euler : faces 0 torus + faces 2 torus ≡ faces 1 torus + faces 3 torus
torus-euler = refl

-- the 1-skeleton is K7: every pair of distinct degrees is an edge
k7 : all (λ σ → not (length σ ==ⁿ 2) || memL σ torus) (subsets degrees) ≡ true
k7 = refl

-- every triangle lies in one or two tetrahedra
torus-triangles-pseudo :
  all (λ σ → not (length σ ==ⁿ 3) || ((cofaces 2 torus σ ==ⁿ 1) || (cofaces 2 torus σ ==ⁿ 2))) torus ≡ true
torus-triangles-pseudo = refl

-- consecutive tetrahedra of the cycle S5 S7 S2 S4 S6 S1 S3 S5 share a triangle
shares-triangle : List Nat → List Nat → Bool
shares-triangle s t = length (filter (λ x → mem x t) s) ==ⁿ 3

S : Nat → List Nat
S n = go n S-list
  where
  go : Nat → List (List Nat) → List Nat
  go _       []       = []
  go zero    (x ∷ _)  = x
  go (suc n) (_ ∷ xs) = go n xs

torus-cycle : shares-triangle (S 4) (S 6) && shares-triangle (S 6) (S 1)
           && shares-triangle (S 1) (S 3) && shares-triangle (S 3) (S 5)
           && shares-triangle (S 5) (S 0) && shares-triangle (S 0) (S 2)
           && shares-triangle (S 2) (S 4) ≡ true
torus-cycle = refl
