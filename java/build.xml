<project name="Rubato" default="compile" basedir=".">

  <path id="project.jars">
    <pathelement path="${classpath}"/>
    <fileset dir="jar">
      <include name="**/*.jar"/>
     </fileset>
  </path>

  <!-- core/src holds the headless core library (math, forms and denotators,
       logeo, XML, Scheme, Denotex, the repository); io/src holds rubato-io
       (MusicXML, Standard MIDI Files and OSC for Score denotators); src holds
       the application. All three compile in place and go into rubato.jar.
       The core-jar and io-jar targets build the two libraries on their own. -->
  <property name="core.src" value="core/src"/>
  <property name="core.build" value="build/core-classes"/>
  <property name="io.src" value="io/src"/>
  <property name="io.build" value="build/io-classes"/>
  <property name="src" value="src"/>
  <property name="build" value="${src}"/>
  <property name="dist" value="dist"/>
  <property name="doc" value="../javadoc"/>

  <target name="init">
    <tstamp/>
  </target>

  <target name="compile" depends="init">
    <javac srcdir="${core.src}:${io.src}:${src}" release="21" encoding="UTF-8" debug="on" includeantruntime="false">
       <classpath refid="project.jars"/>
    </javac>
  </target>

  <!-- Compiles the core library alone, with no jars on the class path and
       only the java.base, java.xml and java.logging modules observable, so a
       reference to the application or to AWT or Swing fails the build. -->
  <target name="core-jar" depends="init">
    <mkdir dir="${core.build}"/>
    <javac srcdir="${core.src}" destdir="${core.build}" encoding="UTF-8" debug="on" includeantruntime="false">
      <exclude name="**/test/**"/>
      <exclude name="**/*Test.java"/>
      <compilerarg line="--release 21 --limit-modules java.base,java.xml,java.logging"/>
    </javac>
    <mkdir dir="${dist}/core"/>
    <jar destfile="${dist}/core/rubato-core.jar">
      <fileset dir="${core.build}"/>
      <fileset dir="${core.src}">
        <exclude name="**/test/**"/>
        <exclude name="**/*.java"/>
        <exclude name="**/*.class"/>
      </fileset>
    </jar>
  </target>

  <!-- Compiles rubato-io alone against the core library built by core-jar,
       with the same three modules observable, so rubato-io cannot use the
       application, AWT, Swing or javax.sound.midi. -->
  <target name="io-jar" depends="core-jar">
    <mkdir dir="${io.build}"/>
    <javac srcdir="${io.src}" destdir="${io.build}" encoding="UTF-8" debug="on" includeantruntime="false">
      <exclude name="**/test/**"/>
      <exclude name="**/*Test.java"/>
      <classpath location="${core.build}"/>
      <compilerarg line="--release 21 --limit-modules java.base,java.xml,java.logging"/>
    </javac>
    <mkdir dir="${dist}/io"/>
    <jar destfile="${dist}/io/rubato-io.jar">
      <fileset dir="${io.build}"/>
    </jar>
  </target>

  <!-- Apache-licensed libraries ship as separate jars in ${dist}/lib, next to
       their license files, instead of being unpacked into rubato.jar.
       See LICENSING.md at the repository root. -->
  <property name="dist.classpath"
            value="lib/flatlaf-3.8.jar lib/commons-math3-3.2.jar lib/xercesImpl-2.6.2.jar lib/collections-generic-4.01.jar"/>

  <target name="dist" depends="compile">
    <mkdir dir="${dist}"/>
    <mkdir dir="${dist}/lib/licenses"/>
    <copy file="jar/flatlaf-3.8.jar" todir="${dist}/lib"/>
    <copy file="jar/commons-math3-3.2.jar" todir="${dist}/lib"/>
    <copy file="jar/xercesImpl.jar" tofile="${dist}/lib/xercesImpl-2.6.2.jar"/>
    <copy file="jar/collections-generic-4.01.jar" todir="${dist}/lib"/>
    <copy todir="${dist}/lib/licenses">
      <fileset dir="licenses"/>
    </copy>
    <jar destfile="${dist}/rubato.jar" index="yes">
      <fileset dir="${core.src}">
        <exclude name="**/test/*"/>
        <exclude name="**/*Test.class"/>
        <exclude name="**/*.java"/>
        <exclude name="org/rubato/test/**"/>
      </fileset>
      <fileset dir="${io.src}">
        <exclude name="**/test/*"/>
        <exclude name="**/*Test.class"/>
        <exclude name="**/*.java"/>
      </fileset>
      <fileset dir="${build}">
        <exclude name="**/test/*"/>
        <exclude name="**/*Test.class"/>
        <exclude name="**/*.java"/>
      </fileset>
      <zipfileset src="jar/repo/org/rubato/vendored/processing-core/2018.11/processing-core-2018.11.jar"/>
      <zipfileset src="jar/repo/org/rubato/vendored/jportaudio/2018.11/jportaudio-2018.11.jar"/>
      <zipfileset src="jar/repo/org/rubato/vendored/jsyn/2018.11/jsyn-2018.11.jar"/>
      <zipfileset src="jar/jung-algorithms-2.0.1.jar"/>
      <zipfileset src="jar/jung-api-2.0.1.jar"/>
      <zipfileset src="jar/jung-graph-impl-2.0.1.jar"/>
      <zipfileset src="jar/jung-visualization-2.0.1.jar"/>
      <!--zipfileset excludes="META-INF/**/*" src="jar/LeapJava.jar" /-->
      <zipfileset src="jar/repo/org/rubato/vendored/mt4j/2018.11/mt4j-2018.11.jar"/>
      <manifest>
        <attribute name="Built-By" value="Florian Thalmann"/>
        <attribute name="Main-Class" value="org.rubato.composer.Composer"/>
        <attribute name="Class-Path" value="${dist.classpath}"/>
        <!--attribute name="Class-Path" value="jar/LeapJava.jar"/-->
      </manifest>
    </jar>
  </target>

  <target name="doc">
    <mkdir dir="${doc}"/>
    <javadoc sourcepath="${core.src}:${io.src}:${src}" 
	     destdir="${doc}" 
             access="public"
             author="true"
             doctitle="Rubato"
             source="21"
	     additionalparam="-charset UTF-8">
      <classpath refid="project.jars"/>
      <package name="org.rubato.*"/>
      <excludepackage name="org.**.test"/>
      <!-- <link href="file:/opt/jdk1.6.0/docs/api/"/> -->
    </javadoc>
  </target>

  <target name="update">
    <cvs dest="${src}" command="update -A -d"/>
  </target>

  <target name="clean">
    <delete dir="${dist}"/>
    <delete dir="${doc}"/>
    <delete dir="build"/>
    <delete>
      <fileset dir="${build}" includes="**/*.class"/>
      <fileset dir="${core.src}" includes="**/*.class"/>
      <fileset dir="${io.src}" includes="**/*.class"/>
    </delete>
  </target>
</project>
