<?xml version="1.0" encoding="UTF-8"?>
<!--
  rubato-io: MusicXML, Standard MIDI File and OSC input and output for
  denotators of form Score (see the parent pom at the repository root). It
  depends on rubato-core only. Sources and tests sit side by side in src.

  As in rubato-core, the compiler sees only the java.base, java.xml and
  java.logging modules. The MIDI code therefore reads and writes Standard
  MIDI Files itself instead of using javax.sound.midi, which is part of the
  java.desktop module. IoBoundaryTest checks the compiled classes as well.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.rubato</groupId>
    <artifactId>rubato-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>rubato-io</artifactId>
  <packaging>jar</packaging>

  <name>Rubato Composer I/O</name>
  <description>MusicXML, Standard MIDI File and Open Sound Control input and output for Rubato Score denotators, without a user interface.</description>

  <dependencies>
    <dependency>
      <groupId>org.rubato</groupId>
      <artifactId>rubato-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>src</testSourceDirectory>
    <resources>
      <resource>
        <directory>src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>**/*.class</exclude>
          <exclude>**/test/**</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>--limit-modules</arg>
                <arg>java.base,java.xml,java.logging</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- the compiler records its module options here; they are a
               build detail, not something the jar's users need -->
          <excludes>
            <exclude>META-INF/jpms.args</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
