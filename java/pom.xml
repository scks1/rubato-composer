<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build of the Rubato Composer application, alongside the Ant build in
  build.xml. The parent pom at the repository root builds it after the
  headless core library in core/ (artifact rubato-core) and rubato-io in io/,
  which it depends on.

  The source tree stays where Ant expects it: src holds production code,
  tests (every **/test/** directory and every *Test.java) and resources side by
  side. The compiler plugin splits them with include and exclude patterns.

  Libraries come from Maven Central where Central has the same classes as the
  jar vendored in java/jar. The six jars with no Central release live in a
  file repository at jar/repo (groupId org.rubato.vendored, version
  2018.11, the date of the last upstream commit). Ant reads the same files, so
  the tree holds one copy of each jar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.rubato</groupId>
    <artifactId>rubato-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rubato-composer</artifactId>
  <packaging>jar</packaging>

  <name>Rubato Composer</name>
  <description>Rubato Composer is a music software based on the concepts and models of mathematical music theory.</description>
  <url>https://github.com/rubato-composer/rubato-composer</url>
  <licenses>
    <license>
      <name>GNU General Public License, version 2</name>
      <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <vendored.version>2018.11</vendored.version>
    <main.class>org.rubato.composer.Composer</main.class>
    <flatlaf.version>3.8</flatlaf.version>
    <commons-math3.version>3.2</commons-math3.version>
    <xerces.version>2.6.2</xerces.version>
    <collections-generic.version>4.01</collections-generic.version>
    <dependency-plugin.version>3.11.0</dependency-plugin.version>
  </properties>

  <repositories>
    <repository>
      <id>rubato-vendored</id>
      <name>Jars vendored in jar/repo</name>
      <url>file://${project.basedir}/jar/repo</url>
      <releases>
        <enabled>true</enabled>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.rubato</groupId>
      <artifactId>rubato-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- java/io: MusicXML, MIDI file and OSC input and output. The shaded
         jar includes it, as the Ant build puts io/src into rubato.jar. -->
    <dependency>
      <groupId>org.rubato</groupId>
      <artifactId>rubato-io</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Maven Central; look and feel (Apache-2.0), installed at startup by
         org.rubato.composer.Theme. java/jar/flatlaf-3.8.jar is the same file
         (sha1 5e06f19b28ef1fa1543fa99ac632903aa2cede6b) for the Ant build. -->
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <!-- Maven Central; class files identical to the vendored jars -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math3</artifactId>
      <version>${commons-math3.version}</version>
    </dependency>
    <dependency>
      <groupId>net.sourceforge.collections</groupId>
      <artifactId>collections-generic</artifactId>
      <version>${collections-generic.version}</version>
    </dependency>
    <dependency>
      <groupId>net.sf.jung</groupId>
      <artifactId>jung-api</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>net.sf.jung</groupId>
      <artifactId>jung-graph-impl</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>net.sf.jung</groupId>
      <artifactId>jung-algorithms</artifactId>
      <version>2.0.1</version>
      <exclusions>
        <!-- Not in the vendored set or in the Ant-built rubato.jar -->
        <exclusion>
          <groupId>colt</groupId>
          <artifactId>colt</artifactId>
        </exclusion>
        <exclusion>
          <groupId>concurrent</groupId>
          <artifactId>concurrent</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>net.sf.jung</groupId>
      <artifactId>jung-visualization</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>xerces</groupId>
      <artifactId>xercesImpl</artifactId>
      <version>${xerces.version}</version>
    </dependency>

    <!-- Vendored jars without a Central release, from java/jar/repo -->
    <dependency>
      <groupId>org.rubato.vendored</groupId>
      <artifactId>processing-core</artifactId>
      <version>${vendored.version}</version>
    </dependency>
    <dependency>
      <groupId>org.rubato.vendored</groupId>
      <artifactId>jsyn</artifactId>
      <version>${vendored.version}</version>
    </dependency>
    <dependency>
      <groupId>org.rubato.vendored</groupId>
      <artifactId>jportaudio</artifactId>
      <version>${vendored.version}</version>
    </dependency>
    <dependency>
      <groupId>org.rubato.vendored</groupId>
      <artifactId>mt4j</artifactId>
      <version>${vendored.version}</version>
    </dependency>
    <!-- Compile-only, as in Ant: neither jar is merged into rubato.jar -->
    <dependency>
      <groupId>org.rubato.vendored</groupId>
      <artifactId>glulogic-mt</artifactId>
      <version>${vendored.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.rubato.vendored</groupId>
      <artifactId>leap-java</artifactId>
      <version>${vendored.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>src</testSourceDirectory>
    <resources>
      <resource>
        <directory>src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>**/*.class</exclude>
          <exclude>**/test/**</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <!-- Needs an audio output device; hangs without one. Run it with
                 -Djsyn.tests=true (see the with-audio profile). -->
            <exclude>${jsyn.test.exclude}</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>copy-separate-jars</id>
            <phase>package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>com.formdev</groupId>
                  <artifactId>flatlaf</artifactId>
                  <version>${flatlaf.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>org.apache.commons</groupId>
                  <artifactId>commons-math3</artifactId>
                  <version>${commons-math3.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>xerces</groupId>
                  <artifactId>xercesImpl</artifactId>
                  <version>${xerces.version}</version>
                </artifactItem>
                <artifactItem>
                  <groupId>net.sourceforge.collections</groupId>
                  <artifactId>collections-generic</artifactId>
                  <version>${collections-generic.version}</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-separate-jar-licenses</id>
            <phase>package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib/licenses</outputDirectory>
              <resources>
                <resource>
                  <directory>licenses</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <!-- Apache-licensed libraries stay separate jars in target/lib
                   (see LICENSING.md); the manifest's Class-Path finds them. -->
              <artifactSet>
                <excludes>
                  <exclude>com.formdev:flatlaf</exclude>
                  <exclude>org.apache.commons:commons-math3</exclude>
                  <exclude>xerces:xercesImpl</exclude>
                  <exclude>net.sourceforge.collections:collections-generic</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                  <manifestEntries>
                    <Class-Path>lib/flatlaf-${flatlaf.version}.jar lib/commons-math3-${commons-math3.version}.jar lib/xercesImpl-${xerces.version}.jar lib/collections-generic-${collections-generic.version}.jar</Class-Path>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>without-audio</id>
      <activation>
        <property>
          <name>!jsyn.tests</name>
        </property>
      </activation>
      <properties>
        <jsyn.test.exclude>**/JSynPlayerTest.java</jsyn.test.exclude>
      </properties>
    </profile>
    <profile>
      <id>with-audio</id>
      <activation>
        <property>
          <name>jsyn.tests</name>
        </property>
      </activation>
      <properties>
        <jsyn.test.exclude>none</jsyn.test.exclude>
      </properties>
    </profile>
  </profiles>
</project>
